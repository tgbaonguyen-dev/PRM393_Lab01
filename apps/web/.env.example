# Google Apps Script Web App Deployment URL
APPS_SCRIPT_GATEWAY_URL=

# Internal HMAC-SHA256 signing secret for dynamic 15-second QR tokens
QR_HMAC_SECRET=

# Google Identity Services (Client ID for Student Google Sign-in)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public URL of the Dart check-in API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
